{
  "name": "dsh-git",
  "version": "0.2.0",
  "private": true,
  "description": "A consistent way to use git and GitHub from DSH. Commits and pushes each turn's work automatically, and redirects raw git in bash at the tool that does it cleanly — so nothing is left uncommitted or unsynced.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stansz/dsh-git.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dsh-git-core": "link:../dsh-git-core",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "lib",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
