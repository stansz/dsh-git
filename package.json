{
  "name": "dsh-git",
  "version": "0.1.0",
  "private": true,
  "description": "One clean git and GitHub surface for DSH: status, per-task worktrees, commit, push, sync, pull requests, and enforcement that stops raw git in bash from leaving dirty trees and unpushed commits behind.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stansz/dsh-git.git"
  },
  "type": "module",
  "main": "index.js",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "lib",
    "scripts",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
